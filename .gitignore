# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# Simulators / local state
mockoon-data/
localstack/
*.local.json

# Generated CI / security reports (JUnit, SBOM, ZAP, DAST logs)
reports/

# Committed evidence artifacts are re-included explicitly: the pilot
# measurement (stable) and its machine-dependent performance companion, and
# the staging rehearsal report directory. Everything else under a reports/
# directory stays ignored.
!evals/reports/
evals/reports/*
!evals/reports/pilot-metrics.json
!evals/reports/pilot-performance.json
!evals/reports/staging/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Local demo stack state (generated CA/certs; never committed)
demo-state/
