# ITSM self-healing platform — environment configuration (copy to .env)
# Secrets: never commit .env. Leave every secret blank here; fill only the
# local copy. Compose and the app fail closed when a required value is empty.

# Compose database bootstrap (used by compose.yaml, not by the app)
POSTGRES_DB=itsm
POSTGRES_USER=itsm
POSTGRES_PASSWORD=
# The API/worker/relay connect as the constrained itsm_app role. The compose
# postgres init hook creates that login with this password on first boot.
ITSM_RUNTIME_DB_PASSWORD=

# Groq (optional — only needed for live LLM smoke tests; core tests run without it)
ITSM_GROQ_API_KEY=
ITSM_GROQ_MODEL=openai/gpt-oss-120b
ITSM_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Persistence
# Admin/owner DSN: used only for migrations and operator queries. Add the
# POSTGRES_PASSWORD value locally before applying migrations.
ITSM_POSTGRES_DSN=postgresql://itsm@localhost:5432/itsm
ITSM_POSTGRES_POOL_MIN=1
ITSM_POSTGRES_POOL_MAX=10

# Messaging
ITSM_NATS_URL=nats://localhost:4222

# Runtime API (`python -m itsm_agent.api`)
ITSM_ENV=local
ITSM_API_HOST=127.0.0.1
ITSM_API_PORT=8000
ITSM_WEBHOOK_SECRET=
ITSM_WEBHOOK_SIGNATURE_HEADER=x-itsm-signature
ITSM_AUTH_MODE=hmac
ITSM_AUTH_HMAC_SECRET=
ITSM_MOCKOON_ITSM_BASE_URL=http://localhost:3001
ITSM_MOCKOON_IDENTITY_BASE_URL=http://localhost:3001
ITSM_MOCKOON_INFRASTRUCTURE_BASE_URL=http://localhost:3001

# Outbox relay (`python -m itsm_agent.workers.relay`)
ITSM_RELAY_BATCH_SIZE=10
ITSM_RELAY_POLL_SECONDS=1.0
ITSM_RELAY_LEASE_SECONDS=60.0

# Retention scheduler (`python -m itsm_agent.workers.retention`)
ITSM_RETENTION_INTERVAL_SECONDS=60
ITSM_RETENTION_BATCH_SIZE=10
ITSM_RETENTION_LEASE_SECONDS=60
ITSM_RETENTION_MAX_ATTEMPTS=5
ITSM_RETENTION_BACKOFF_SECONDS=30

# Runtime
ITSM_LOG_LEVEL=INFO
ITSM_OTEL_EXPORTER_ENDPOINT=
ITSM_METRICS_ENABLED=true
ITSM_SIMULATOR_SEED=42

# Adapter limits
ITSM_ADAPTER_MAX_RETRIES=3
ITSM_ADAPTER_TIMEOUT_SECONDS=5.0
